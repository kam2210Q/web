<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Coding Learning Web</title>
  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', sans-serif;
      background: #fafafa;
      color: #444;
    }

    header {
      background: #4cafef; /* Coding blue */
      color: white;
      text-align: center;
      padding: 20px;
    }

    nav {
      display: flex;
      justify-content: center;
      gap: 30px;
      background: #333;
      padding: 15px;
    }

    nav a {
      color: #fefefe;
      text-decoration: none;
      font-weight: bold;
    }

    nav a:hover {
      color: #4cafef;
    }

    .hero {
      text-align: center;
      padding: 60px 20px;
      background: linear-gradient(to right, #4cafef, #00c6ff);
      color: white;
    }

    .hero button {
      margin-top: 20px;
      padding: 12px 25px;
      border: none;
      background: white;
      color: #4cafef;
      font-weight: bold;
      border-radius: 5px;
      cursor: pointer;
    }

    .hero button:hover {
      background: #00c6ff;
      color: white;
    }

    .features {
      padding: 40px 20px;
    }

    .feature {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 30px 0;
      background: #ffffff;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    }

    .feature:nth-child(even) {
      flex-direction: row-reverse;
      background: #e0f7fa;
    }

    .feature h3 {
      margin: 0;
      color: #4cafef;
    }

    .feature p {
      margin: 10px 0 0;
    }

    .feature img {
      width: 120px;
      height: 120px;
      object-fit: cover;
      border-radius: 8px;
      margin: 0 20px;
    }

    .gallery {
      padding: 40px 20px;
      background: #f4f6f9;
    }

    .gallery h2 {
      text-align: center;
      color: #4cafef;
      margin-bottom: 30px;
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }

    .gallery-grid img {
      width: 100%;
      border-radius: 8px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      transition: transform 0.3s ease;
    }

    .gallery-grid img:hover {
      transform: scale(1.05);
    }

    .about {
      background: #222;
      padding: 40px;
      text-align: center;
      color: #eee;
    }

    .about h2 {
      color: #fdd835;
      margin-bottom: 20px;
    }

    .about p {
      max-width: 600px;
      margin: auto;
      line-height: 1.6;
    }

    footer {
      background: #000;
      color: #aaa;
      text-align: center;
      padding: 15px;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <header>
    <h1>Coding Learning Hub</h1>
  </header>

  <nav>
    <a href="#">Home</a>
    <a href="#">Courses</a>
    <a href="#">Projects</a>
    <a href="#">Contact</a>
  </nav>

  <section class="hero">
    <h2>Learn Coding the Smart Way</h2>
    <button>Start Learning</button>
  </section>

  <section class="features">
    <div class="feature">
      <img src="c:\Users\anand\OneDrive\Pictures\Screenshots\Screenshot 2026-04-22 092315.png" alt="Responsive Design">
      <div>
        <h3>Interactive Lessons</h3>
        <p>Practice coding with hands-on examples and real-time feedback.</p>
      </div>
    </div>

    <div class="feature">
      <img src="c:\Users\anand\Downloads\Books\Random\314785.jpg" alt="Easy Alignment">
      <div>
        <h3>Project-Based Learning</h3>
        <p>Build real-world projects to strengthen your coding skills.</p>
      </div>
    </div>

    <div class="feature">
      <img src="" alt="Flexible Layouts">
      <div>
        <h3>Flexible Curriculum</h3>
        <p>Learn at your own pace with structured modules and challenges.</p>
      </div>
    </div>
  </section>

  <section class="gallery">
    <h2>Gallery</h2>
    <div class="gallery-grid">
      <img src="" alt="Coding Gallery 1">
      <img src="" alt="Coding Gallery 2">
      <img src="" alt="Coding Gallery 3">
      <img src="" alt="Coding Gallery 4">
    </div>
  </section>

  <section class="about">
    <h2>About Us</h2>
    <p>
      We are dedicated to helping learners master coding through interactive lessons, projects, and community support. 
      Our platform combines modern design with responsive techniques to make learning fun and effective.
    </p>
  </section>

  <footer>
    © 2026 Coding Learning Hub. All rights reserved.
  </footer>
</body>
</html>
